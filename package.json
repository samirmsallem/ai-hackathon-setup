{
  "name": "sdv-agentic-engineering-hackathon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SDV Agentic Engineering Hackathon - interactive orchestrator and SDV Vehicle Diagnostics Assistant challenge",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:harness": "vitest run tests/harness",
    "test:acceptance": "vitest run tests/acceptance",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate.mjs",
    "demo": "node scripts/demo.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "hackathon:init": "node scripts/initialize-hackathon.mjs",
    "hackathon:results": "node scripts/generate-results.mjs",
    "hackathon:reset": "node scripts/reset.mjs",
    "event:prepare": "node scripts/prepare-event.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  }
}
